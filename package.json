{
  "name": "@drawio/react",
  "version": "0.1.0",
  "description": "React component for the draw.io editor in embed mode, with a typed JSON protocol",
  "keywords": [
    "drawio",
    "draw.io",
    "diagrams",
    "diagram-editor",
    "react",
    "embed",
    "iframe"
  ],
  "homepage": "https://www.drawio.com/react",
  "bugs": {
    "url": "https://github.com/jgraph/drawio-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jgraph/drawio-react.git"
  },
  "license": "Apache-2.0",
  "author": "draw.io Ltd",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "examples": "vite examples",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
